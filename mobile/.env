# Where the cloud backend lives. These two values are public by design: they ship
# inside every copy of the app, and the database only lets a signed-in student
# read and write their own rows (row-level security). Committing them means a
# fresh clone builds with sign-in and sync working, with no setup.
#
# Never put the secret (service_role) key or the database password in this file.
# To point at a different Supabase project, override both in .env.local.
EXPO_PUBLIC_SUPABASE_URL=https://mjbujhsixgfaluhuvxnn.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_yJKdVmwteZLOU1mgIggTiA_Pg3o3Z5R
