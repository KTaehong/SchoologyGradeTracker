{
  "expo": {
    "name": "Grade Tracker",
    "slug": "schoology-grade-tracker",
    "version": "1.0.0",
    "description": "See, forecast and plan your Schoology grades. Works offline; an optional account syncs your grades between devices.",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gradetracker",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.ktaehong.gradetracker",
      "usesAppleSignIn": true,
      "icon": "./assets/images/icon.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": false,
          "NSAllowsLocalNetworking": true
        }
      },
      "supportsTablet": false
    },
    "android": {
      "package": "com.ktaehong.gradetracker",
      "adaptiveIcon": {
        "backgroundColor": "#2A7FEA",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-sqlite",
      "expo-apple-authentication",
      [
        "expo-image-picker",
        {
          "photosPermission": "Pick a screenshot of your Schoology grades so the app can read the scores.",
          "cameraPermission": "Take a photo of your Schoology grades so the app can read the scores.",
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
